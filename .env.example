# Copy to .env for Docker Compose. Spring Boot does not load .env automatically.
# Export variables in your shell or configure the IDE run environment as well.
SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=saludyadb
DB_URL=jdbc:postgresql://localhost:5432/saludyadb
DB_USER=saludya
DB_PASSWORD=saludya-dev
IAM_IDENTITY_MODE=fixtures
IAM_STAFF_EMAIL_DOMAINS=example.test
IAM_MAIL_ENABLED=true
IAM_SMTP_HOST=localhost
IAM_SMTP_PORT=1025
IAM_SMTP_AUTH=false
IAM_SMTP_TLS=false
IAM_MAIL_FROM=no-reply@saludya.local
IAM_PASSWORD_RESET_URL=http://localhost:3000/reset-password
IAM_SUPPORT_PHONE=
IAM_SUPPORT_INSTRUCTIONS=Acude al area de admision con tu DNI original.
IAM_CORS_ORIGINS=http://localhost:3000
IAM_BOOTSTRAP_ENABLED=false
IAM_BOOTSTRAP_EMAIL=
IAM_BOOTSTRAP_PASSWORD=
IAM_BOOTSTRAP_DNI=
IAM_BOOTSTRAP_PHONE=

# Production: set SPRING_PROFILES_ACTIVE=prod, real PostgreSQL/SMTP/support
# configuration, a trusted identity gateway and a deployed frontend reset URL.
# JWT secret: at least 32 unpredictable bytes; notification key: Base64 of 32 random bytes.
# Never use development keys in production. Generate independent secrets.
IAM_JWT_SECRET=
IAM_NOTIFICATION_KEY=
IAM_IDENTITY_URL=
IAM_IDENTITY_API_KEY=
IAM_SMTP_USER=
IAM_SMTP_PASSWORD=
